<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Árvore de pensamento: fugir se levou dano > zoomies evasivos (ameaça por perto) > zoomies > seguir o favorito > árvore normal de animais -->
  <ThinkTreeDef>
    <defName>Wisk_AnimalMain</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="Wisk.JobGiver_FleeToSafety" />
        <li Class="Wisk.JobGiver_EvasiveZoomies" />
        <li Class="Wisk.JobGiver_Zoomies" />
        <li Class="Wisk.JobGiver_FollowFavorite" />
        <li Class="ThinkNode_Subtree">
          <treeDef>Animal</treeDef>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <JobDef>
    <defName>Wisk_FollowFavorite</defName>
    <driverClass>Wisk.JobDriver_FollowFavorite</driverClass>
    <reportString>seguindo TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Wisk_FleeToSafety</defName>
    <driverClass>Wisk.JobDriver_FleeToSafety</driverClass>
    <reportString>fugindo para um lugar seguro.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Wisk_EvasiveZoomies</defName>
    <driverClass>Wisk.JobDriver_EvasiveZoomies</driverClass>
    <reportString>fazendo zoomies para distrair o inimigo.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Wisk_TauntOrbit</defName>
    <driverClass>Wisk.JobDriver_TauntOrbit</driverClass>
    <reportString>provocando TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Wisk_Zoomies</defName>
    <driverClass>Wisk.JobDriver_Zoomies</driverClass>
    <reportString>correndo de felicidade (zoomies).</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <!-- Recreação: brincar com o cachorro -->
  <JoyKindDef>
    <defName>Wisk_PetPlay</defName>
    <label>brincar com pet</label>
  </JoyKindDef>

  <JobDef>
    <defName>Wisk_PlayWithPet</defName>
    <driverClass>Wisk.JobDriver_PlayWithPet</driverClass>
    <reportString>brincando com TargetA.</reportString>
    <joyDuration>800</joyDuration>
    <joyGainRate>1.0</joyGainRate>
    <joyKind>Wisk_PetPlay</joyKind>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JoyGiverDef>
    <defName>Wisk_PlayWithPet</defName>
    <giverClass>Wisk.JoyGiver_PlayWithPet</giverClass>
    <baseChance>0.7</baseChance>
    <jobDef>Wisk_PlayWithPet</jobDef>
    <joyKind>Wisk_PetPlay</joyKind>
    <requiredCapacities>
      <li>Moving</li>
    </requiredCapacities>
  </JoyGiverDef>

  <ThoughtDef>
    <defName>Wisk_PlayedWithPet</defName>
    <durationDays>0.6</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.7</stackedEffectMultiplier>
    <stages>
      <li>
        <label>brincou com o cachorro</label>
        <description>Brincar com o cachorro melhorou meu dia.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Wisk_WatchedZoomies</defName>
    <durationDays>0.4</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>viu o cachorro correndo feliz</label>
        <description>Ver o cachorro correndo doido de alegria é impossível de não achar fofo.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Morte do Wisk -->
  <ThoughtDef>
    <defName>Wisk_Died</defName>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>o Wisk morreu</label>
        <description>O Wisk se foi. Dói demais.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Wisk_KilledWisk</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>60</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>matou o Wisk</label>
        <baseOpinionOffset>-100</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Wisk_IKilledWisk</defName>
    <durationDays>15</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>matei o Wisk</label>
        <description>Eu matei o Wisk. Não existe perdão pra isso.</description>
        <baseMoodEffect>-25</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
